#!/bin/sh
# burrow — the Burrow IDE's control CLI.
#
# Every app action is a VERB served by the running app over loopback HTTP:
#
#   burrow <verb> [POSITIONAL] [--arg value ...]
#
# and `burrow help` lists the verbs the running app actually supports (the list
# is generated from the app's verb registry, so it can never drift from reality).
# Common ones:
#
#   burrow spawn "<task>" [--agent A] [--model M] [--cwd DIR] [--target tab|chat]
#       Delegate a task to a sub-agent in a new tab (or chat). Prints the tab id
#       and a result token.
#   burrow wait <token> [--timeout S]       Block for that sub-agent's result.
#   burrow collect-results                  Take every finished result.
#   burrow agent-status                     What every agent in the app is doing.
#   burrow tab-output <pty_id> [--lines N]  Read a running agent's output.
#   burrow send-to-tab <pty_id> "<text>"    Send a follow-up into a running agent.
#
# Verb names may be written with dashes or underscores. Arguments are sent as
# JSON, so quote anything containing spaces.
#
# Sub-agents run INTERACTIVELY on your subscription (plain `claude`, never -p).
#
# The other subcommands (status, hook, notify, capture) are the agent-status
# plumbing invoked by hooks, not by you. They keep their own transport: a bare
# POST that works even before the control API is up.

sub="$1"
[ -n "$sub" ] || { echo "usage: burrow <verb> [args] — run 'burrow help' for the verb list" >&2; exit 1; }
shift

# --- control API client -------------------------------------------------------

# _port: the app's loopback port. The file is authoritative (rewritten every
# launch, self-reclaimed when stale); the env var is baked into the PTY at
# creation, so it's the one that goes stale after an app restart.
_port() {
  if [ -n "$BURROW_HOME_DIR" ] && [ -f "$BURROW_HOME_DIR/hook.port" ]; then
    head -n1 "$BURROW_HOME_DIR/hook.port" 2>/dev/null && return 0
  fi
  printf '%s' "$BURROW_HOOK_PORT"
}

# The control API is authenticated: loopback is reachable by every process on
# this machine and `spawn` starts programs, so the token gates it. 0600, written
# by the app next to hook.port.
_token() {
  [ -n "$BURROW_HOME_DIR" ] && cat "$BURROW_HOME_DIR/control.token" 2>/dev/null
}

_esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/	/\\t/g'; }

# _primary <verb> — argument names the positional arguments fill, in order, so
# `burrow spawn "fix the bug"` works without naming --task. Verbs absent here
# take named arguments only.
_primary() {
  case "$1" in
    spawn)                       echo "task" ;;
    wait|wait_result)            echo "token" ;;
    run)                         echo "cmd" ;;
    tab_output)                  echo "pty_id" ;;
    send_to_tab)                 echo "pty_id text" ;;
    tab_rename)                  echo "pty_id title" ;;
    tab_close|focus_tab)         echo "pty_id" ;;
    focus_workspace|list_tabs)   echo "workspace_id" ;;
    create_worktree|worktree_remove) echo "branch" ;;
    workspace_create)            echo "path" ;;
    pr_view|pr_merge)            echo "number" ;;
    diagram)                     echo "content" ;;
    *)                           echo "" ;;
  esac
}

_call() {
  verb=$(printf '%s' "$1" | tr '-' '_'); shift
  [ "$verb" = "wait" ] && verb="wait_result"
  [ "$verb" = "collect" ] && verb="collect_results"

  # Caller's directory: every verb that acts on "this repo" resolves it from
  # here, so an agent never has to know workspace row ids.
  json="\"cwd\":\"$(_esc "${BURROW_CWD:-$PWD}")\""
  positional=$(_primary "$verb")

  while [ $# -gt 0 ]; do
    case "$1" in
      --*)
        key=$(printf '%s' "${1#--}" | tr '-' '_')
        case "$2" in
          ''|--*) val="true" ;;        # bare flag, e.g. --force
          *)      val="$2"; shift ;;
        esac
        json="$json,\"$key\":\"$(_esc "$val")\""
        shift
        ;;
      *)
        name=$(printf '%s' "$positional" | cut -d' ' -f1)
        positional=$(printf '%s' "$positional" | cut -s -d' ' -f2-)
        if [ -z "$name" ]; then
          echo "burrow $verb: unexpected argument '$1' — pass it as --name value" >&2
          exit 1
        fi
        json="$json,\"$name\":\"$(_esc "$1")\""
        shift
        ;;
    esac
  done

  port=$(_port); token=$(_token)
  if [ -z "$port" ]; then
    echo "burrow: Burrow is not running (no hook.port) — start the app and retry" >&2
    exit 1
  fi
  if [ -z "$token" ]; then
    echo "burrow: no control token in $BURROW_HOME_DIR — is this shell running inside Burrow?" >&2
    exit 1
  fi

  # wait_result blocks by design (a sub-agent takes minutes), so no --max-time.
  body=$(curl -s -X POST "http://127.0.0.1:$port/v1/$verb" \
    -H 'Content-Type: application/json' \
    -H "Authorization: Bearer $token" \
    -d "{$json}" -w '\n%{http_code}')
  code=$(printf '%s' "$body" | tail -n1)
  payload=$(printf '%s' "$body" | sed '$d')

  case "$code" in
    200) printf '%s\n' "$payload" ;;
    404) echo "burrow: unknown verb '$verb' — run 'burrow help' for the list" >&2; exit 1 ;;
    401) echo "burrow: control token rejected — restart Burrow to reissue it" >&2; exit 1 ;;
    *)   printf '%s\n' "$payload" >&2; exit 1 ;;
  esac
}

case "$sub" in
  help|--help|-h)
    echo "burrow <verb> [POSITIONAL] [--arg value ...]"
    echo
    echo "Verbs supported by the running app:"
    _call _verbs
    ;;

  status)
    # burrow status <running|waiting|permission|done|error|session> [meta...]
    #   --detail D   error type string  (state=error,   e.g. billing_error)
    #   --model M    active model        (state=session)
    #   --source S   startup|resume|...  (state=session)
    #   --title  T   session title       (state=session)
    #   --pid    P   agent process pid   (any state; enables the liveness sweep —
    #                Burrow kill(pid,0)-polls it to clear a stuck dot when the agent
    #                dies. Sent with $(hostname) so a remote/SSH pid is ignored.)
    # Report this tab's agent state to Burrow's hook server. Any agent can call
    # this from a hook/notify program. Needs BURROW_PTY_ID + BURROW_HOOK_PORT
    # (exported into every Burrow PTY). No-op outside Burrow.
    state="$1"
    [ -n "$state" ] || { echo "burrow status: no state (running|waiting|permission|done|error|session)" >&2; exit 1; }
    shift
    # Optional metadata — only error/session use any of these.
    detail=""; s_model=""; s_source=""; s_title=""; pid=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --detail) detail="$2";   shift 2 ;;
        --model)  s_model="$2";  shift 2 ;;
        --source) s_source="$2"; shift 2 ;;
        --title)  s_title="$2";  shift 2 ;;
        --pid)    pid="$2";      shift 2 ;;
        *)        shift ;;
      esac
    done
    [ -n "$BURROW_PTY_ID" ] || exit 0
    # Two possible ports, neither reliable alone:
    #   - $BURROW_HOOK_PORT  is baked into the PTY env at creation → CORRECT for a
    #     fresh PTY in the running app, but STALE for one reattached after restart.
    #   - $BURROW_HOME_DIR/hook.port (line 1 = port, line 2 = owning pid) is
    #     rewritten each launch → CORRECT after a restart. A transient instance
    #     (e.g. a `tauri:dev` run) can still clobber it, but the live app now
    #     self-reclaims the file when its recorded pid is dead, so it converges
    #     back within ~3s instead of staying stale forever.
    # So try BOTH (FILE first — it's authoritative: rewritten every launch and
    # self-reclaimed when stale; env is baked at PTY creation so it's the one that
    # goes stale after a restart). -f makes curl fail on a dead port so we fall
    # through to the next candidate. head -n1 reads just the port line (the pid on
    # line 2 is for the app's reclaim loop). Retry a few times: the live window the
    # file_port can be momentarily wrong is the ~3s reclaim, so a short retry loop
    # lets a dropped POST self-heal instead of silently losing the state update.
    file_port=""
    [ -n "$BURROW_HOME_DIR" ] && [ -f "$BURROW_HOME_DIR/hook.port" ] && \
      file_port=$(head -n1 "$BURROW_HOME_DIR/hook.port" 2>/dev/null)
    # Build the JSON payload: base {ptyId,state} plus any provided metadata. Values
    # are JSON-escaped (backslash + double-quote) so titles/details can't break it.
    _esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
    payload="{\"ptyId\":$BURROW_PTY_ID,\"state\":\"$state\""
    [ -n "$detail" ]   && payload="$payload,\"detail\":\"$(_esc "$detail")\""
    [ -n "$s_model" ]  && payload="$payload,\"model\":\"$(_esc "$s_model")\""
    [ -n "$s_source" ] && payload="$payload,\"source\":\"$(_esc "$s_source")\""
    [ -n "$s_title" ]  && payload="$payload,\"title\":\"$(_esc "$s_title")\""
    # PID-based liveness (supacode-style): include the agent process pid + the host
    # it lives on so Burrow can kill(pid,0)-poll it and clear a stuck dot the instant
    # the agent dies. `host` gates the sweep: Burrow only trusts the pid when it
    # matches its OWN hostname (a pid reported over SSH is a REMOTE pid — checking it
    # locally would be meaningless / a false positive). Only sent when --pid given
    # (the hook passes the agent pid; ad-hoc `burrow status` calls omit it).
    if [ -n "$pid" ]; then
      host=$(hostname 2>/dev/null)
      payload="$payload,\"pid\":$pid,\"host\":\"$(_esc "$host")\""
    fi
    payload="$payload}"
    # Only the STICKY states (waiting/permission/done/error/session) get the slow
    # retry loop: if one is lost the dot/metadata is stuck until the next turn.
    # `running` fires on every tool call and a lost one self-corrects on the very
    # next event, so it takes a single fast attempt — never block the agent with
    # sleeps when the app is down.
    case "$state" in
      waiting|permission|done|error|session) _max=3 ;;
      *)                                      _max=1 ;;
    esac
    _attempt=0
    while [ "$_attempt" -lt "$_max" ]; do
      for port in "$file_port" "$BURROW_HOOK_PORT"; do
        [ -n "$port" ] || continue
        if curl -sf -X POST "http://127.0.0.1:$port/hook" \
            -H 'Content-Type: application/json' \
            -d "$payload" >/dev/null 2>&1; then
          exit 0
        fi
      done
      # Re-read the file_port — a reclaim may have just rewritten it.
      [ -n "$BURROW_HOME_DIR" ] && [ -f "$BURROW_HOME_DIR/hook.port" ] && \
        file_port=$(head -n1 "$BURROW_HOME_DIR/hook.port" 2>/dev/null)
      _attempt=$((_attempt + 1))
      [ "$_attempt" -lt "$_max" ] && sleep 1
    done
    exit 0
    ;;

  hook)
    # burrow hook   (internal — invoked by globally-installed Claude/Codex hooks)
    # Reads the hook JSON on stdin, maps hook_event_name → a Burrow state, forwards
    # via `burrow status`. No-op outside Burrow (BURROW_PTY_ID unset). Best-effort
    # string parse, no jq/node needed.
    [ -n "$BURROW_PTY_ID" ] || exit 0
    # Durable agent pid for the liveness sweep. Claude/Codex run the hook as
    # `sh -c '<burrow hook>'`, so OUR $PPID is that throwaway wrapper shell (it exits
    # the instant the hook returns — using it would falsely clear a LIVE agent). The
    # wrapper's parent IS the long-lived agent process (claude/codex), so climb one
    # level: `ps -o ppid= -p $PPID`. Fall back to $PPID if ps is unavailable.
    agent_pid=$(ps -o ppid= -p "$PPID" 2>/dev/null | tr -d ' \t\n')
    case "$agent_pid" in
      ''|*[!0-9]*) agent_pid="$PPID" ;;
    esac
    json=$(cat)
    ev=$(printf '%s' "$json" | sed -n 's/.*"hook_event_name"[ ]*:[ ]*"\([^"]*\)".*/\1/p')
    tool=$(printf '%s' "$json" | sed -n 's/.*"tool_name"[ ]*:[ ]*"\([^"]*\)".*/\1/p')
    case "$ev" in
      UserPromptSubmit)
        state=running
        # Save current git HEAD so `burrow diff --last-turn` can show what changed.
        if [ -n "$BURROW_SESSION_DIR" ] && [ -n "$BURROW_PTY_ID" ]; then
          git_head=$(git rev-parse HEAD 2>/dev/null)
          [ -n "$git_head" ] && printf '%s\n%s' "$git_head" "$PWD" \
            > "$BURROW_SESSION_DIR/last_head_${BURROW_PTY_ID}"
        fi
        # Persist session_id so Burrow can auto-resume this conversation on restart.
        session_id=$(printf '%s' "$json" | sed -n 's/.*"session_id"[ ]*:[ ]*"\([^"]*\)".*/\1/p')
        if [ -n "$session_id" ]; then
          file_port=""
          [ -n "$BURROW_HOME_DIR" ] && [ -f "$BURROW_HOME_DIR/hook.port" ] && \
            file_port=$(head -n1 "$BURROW_HOME_DIR/hook.port" 2>/dev/null)
          for port in "$file_port" "$BURROW_HOOK_PORT"; do
            [ -n "$port" ] || continue
            curl -sf -X POST "http://127.0.0.1:$port/session-id" \
              -H 'Content-Type: application/json' \
              -d "{\"ptyId\":$BURROW_PTY_ID,\"sessionId\":\"$session_id\"}" \
              >/dev/null 2>&1 && break
          done
        fi
        # Auto-title the tab from the first line of the user prompt.
        prompt_title=$(printf '%s' "$json" | python3 -c "
import sys, json, re
try:
  d = json.load(sys.stdin)
  p = d.get('prompt','') or ''
  p = re.sub(r'\x1b\[[0-9;]*[A-Za-z]', '', p)
  line = next((l.strip() for l in p.splitlines() if l.strip()), '')
  print(line[:60])
except: pass
" 2>/dev/null)
        [ -n "$prompt_title" ] && \
          burrow status session --title "$prompt_title" --pid "$agent_pid"
        ;;
      PreToolUse)
        # A turn that calls a BLOCKING tool parks waiting on the operator — flag it
        # as `waiting` ("needs you"), not plain `running`. Same set tank gates on
        # (AskUserQuestion = a question, ExitPlanMode = a plan to approve). The
        # matching PostToolUse flips back to running once the user answers.
        case "$tool" in
          AskUserQuestion|ExitPlanMode) state=waiting ;;
          *)                            state=running ;;
        esac ;;
      PostToolUse)                state=running ;;
      SessionStart)
        # Session (re)started mid-tab. Forward model/source/title as metadata so
        # Burrow can label the tab. source=startup|resume|clear|compact.
        s_source=$(printf '%s' "$json" | sed -n 's/.*"source"[ ]*:[ ]*"\([^"]*\)".*/\1/p')
        s_model=$(printf '%s' "$json" | sed -n 's/.*"model"[ ]*:[ ]*"\([^"]*\)".*/\1/p')
        s_title=$(printf '%s' "$json" | sed -n 's/.*"session_title"[ ]*:[ ]*"\([^"]*\)".*/\1/p')
        burrow status session --model "$s_model" --source "$s_source" --title "$s_title" --pid "$agent_pid"
        exit 0 ;;
      StopFailure)
        # The turn ended on an API error (rate_limit, billing_error, server_error,
        # …). error_type holds the matcher value; pass it through as the detail.
        etype=$(printf '%s' "$json" | sed -n 's/.*"error_type"[ ]*:[ ]*"\([^"]*\)".*/\1/p')
        [ -n "$etype" ] || etype=unknown
        burrow status error --detail "$etype" --pid "$agent_pid"
        exit 0 ;;
      PermissionRequest)          state=permission ;;
      Stop)
        # A Stop carrying still-running background_tasks is an INTERIM stop: the
        # agent spawned background sub-agents and parked waiting on them, and Claude
        # auto-resumes the SAME session when they return (tank: 'background_waiting',
        # cmux: fullyIdle=false → stay running). Reporting `done` here is the premature
        # -completion bug. Detect a running background task and keep state running; a
        # bare Stop (no pending background work) is a real turn end → done.
        # Scope the status check to the background_tasks ARRAY only. The old code
        # grepped the whole document for any "status":"running", so an unrelated
        # status field elsewhere in the JSON could falsely keep the turn running.
        # Isolate from `"background_tasks"` up to the first closing `]`, then look
        # for a live task inside that slice.
        bg=$(printf '%s' "$json" | sed -n 's/.*\("background_tasks"[^]]*\).*/\1/p')
        if [ -n "$bg" ] \
           && printf '%s' "$bg" | grep -Eq '"status"[ ]*:[ ]*"(running|pending|in_progress)"'; then
          state=running
        else
          state=done
          # Fallback result capture: XTerm writes a token sidecar when spawning with
          # --token. In Claude Code ≥ 2.1.195 the global Stop hook overrides the
          # per-launch --settings hook, so burrow capture never fires from there.
          # Read the sidecar here so `burrow collect` doesn't block forever.
          # Consumes the file to avoid double-capture; idempotent if the per-launch
          # hook also ran (it just overwrites .done/.result, which is fine).
          if [ -n "$BURROW_PTY_ID" ] && [ -n "$BURROW_SESSION_DIR" ]; then
            _tok_file="/tmp/agentic-ide-token-${BURROW_PTY_ID}"
            if [ -f "$_tok_file" ]; then
              _tok=$(cat "$_tok_file")
              rm -f "$_tok_file"
              if [ -n "$_tok" ]; then
                printf '%s' "$json" | burrow capture "$_tok"
                exit 0
              fi
            fi
          fi
        fi ;;
      Notification)
        # Refined mapping: most notifications are telemetry (idle pings, auth/
        # elicitation events), but the `type` field disambiguates the actionable
        # ones. permission_prompt → the agent needs an allow/deny decision;
        # idle_prompt → it's parked waiting on you. Everything else stays a no-op
        # (the old blanket behavior). Real PermissionRequest events still arrive on
        # their own channel; this just rescues clients that surface it as a
        # Notification instead.
        ntype=$(printf '%s' "$json" | sed -n 's/.*"type"[ ]*:[ ]*"\([^"]*\)".*/\1/p')
        case "$ntype" in
          permission_prompt) state=permission ;;
          idle_prompt)       state=waiting ;;
          *)                 exit 0 ;;
        esac ;;
      # SubagentStop is a sub-agent internal event, not a top-level turn end.
      SubagentStop|SessionEnd|*) exit 0 ;;
    esac
    burrow status "$state" --pid "$agent_pid"
    exit 0
    ;;

  notify)
    # burrow notify '<json>'   (internal — invoked by Codex's `notify` program)
    # Codex passes a single JSON arg describing a lifecycle event. Map its "type"
    # to a Burrow state and forward via `burrow status`. Best-effort string parse
    # (no jq/node dependency — Codex users may not have node).
    json="$1"
    [ -n "$json" ] || exit 0
    type=$(printf '%s' "$json" | sed -n 's/.*"type"[ ]*:[ ]*"\([^"]*\)".*/\1/p')
    case "$type" in
      task_started|task-started|turn_started)              state=running ;;
      agent-turn-complete|task_complete|turn_complete)     state=done ;;
      *approval*|*approval_request|request_user_input)     state=waiting ;;
      *)                                                   exit 0 ;;
    esac
    burrow status "$state"
    exit 0
    ;;

  capture)
    token="$1"
    dir="${BURROW_SESSION_DIR:?}"
    [ -n "$token" ] || exit 0
    # Parse Stop-hook JSON (stdin) → transcript_path → last assistant text,
    # write <token>.result then <token>.done. Node is always present (Claude
    # Code requires it), so we don't depend on jq.
    BURROW_DIR="$dir" BURROW_TOKEN="$token" node -e '
      let raw = "";
      process.stdin.on("data", d => raw += d).on("end", () => {
        const fs = require("fs"), path = require("path");
        const dir = process.env.BURROW_DIR, tok = process.env.BURROW_TOKEN;
        let text = "";
        try {
          const tp = JSON.parse(raw).transcript_path;
          if (tp && fs.existsSync(tp)) {
            const lines = fs.readFileSync(tp, "utf8").split("\n").filter(Boolean);
            for (let i = lines.length - 1; i >= 0; i--) {
              let o; try { o = JSON.parse(lines[i]); } catch { continue; }
              const m = o.message || o;
              if ((o.type === "assistant" || m.role === "assistant") && m.content) {
                text = (Array.isArray(m.content) ? m.content : [m.content])
                  .map(c => typeof c === "string" ? c : (c && c.type === "text" ? c.text : ""))
                  .join("");
                if (text.trim()) break;
              }
            }
          }
        } catch {}
        try { fs.writeFileSync(path.join(dir, tok + ".result"), text); } catch {}
        try { fs.writeFileSync(path.join(dir, tok + ".done"), ""); } catch {}
      });
    '
    # Also report the turn as done to the status server. A spawned sub-agent runs
    # with a per-launch `--settings` whose Stop hook is THIS capture; Claude Code
    # gives that file precedence and does NOT also run the globally-installed
    # `burrow hook` Stop (same event), so without this the sub-agent's status dot
    # would stay stuck orange after it finishes. (No-op outside Burrow.)
    burrow status done
    # Notify the Manager that a sub-agent result is ready for collect.
    # No-op if not in a Burrow PTY or if the hook server isn't reachable.
    if [ -n "$BURROW_PTY_ID" ] && [ -n "$token" ]; then
      _port=$(head -n1 "$BURROW_HOME_DIR/hook.port" 2>/dev/null)
      [ -z "$_port" ] && _port="$BURROW_HOOK_PORT"
      [ -n "$_port" ] && curl -sf -o /dev/null -X POST "http://127.0.0.1:$_port/agent-done" \
        -H 'Content-Type: application/json' \
        -d "{\"token\":\"$token\"}" 2>/dev/null || true
    fi
    exit 0
    ;;
  *)
    # Anything else is a control verb; the app answers 404 for a name it has no
    # verb for, which keeps this script from having to know the registry.
    _call "$sub" "$@"
    ;;
esac
