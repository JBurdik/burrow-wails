# Burrow (Go+Wails) — task runner. Install `just`: brew install just
# Run `just` with no args to list recipes.

set shell := ["bash", "-uc"]

# ── dev ───────────────────────────────────────────────────────────────────────

# Native dev window (hot-reload)
dev:
    wails dev

# Type-check + build check, no bundle
check:
    go vet ./...
    go build ./...

# ── build ─────────────────────────────────────────────────────────────────────

# Full native build (unsigned, local testing only — no notarization/updater yet)
build:
    wails build

# Build the standalone daemon binary alongside the app bundle
build-daemon:
    go build -o build/bin/burrow.app/Contents/MacOS/burrow-daemon ./cmd/burrow-daemon

# ── release (not wired up yet) ──────────────────────────────────────────────────

# TODO once we're past local testing: port justfile's `bump`/`release`/`verify`/
# `notary-creds` recipes — signing identity, notarization, and the updater
# manifest format still need a Go-side equivalent (see docs/plans, phase 7).
release *args:
    @echo "release flow not ported yet — see justfile TODO / plan phase 7"
    @exit 1
